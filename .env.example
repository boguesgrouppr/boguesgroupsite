NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local: set in .env
# Production: Cloudflare → Workers & Pages → boguesgroupsite → Settings → Variables and Secrets
#   - MAILCHIMP_API_KEY = Secret (required)
#   - MAILCHIMP_SERVER_PREFIX, MAILCHIMP_LIST_ID = plain variables
#   - Also add to Build variables and secrets if using Workers Builds
#   - Redeploy after saving
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us5
MAILCHIMP_NEWSLETTER_TAG_NAME=
MAILCHIMP_HOMEPAGE_NEWSLETTER_TAG_NAME=homepage-newsletter
MAILCHIMP_CASE_STUDY_DOWNLOAD_TAG_NAME=case-study-download
MAILCHIMP_BLOG_DOWNLOAD_TAG_NAME=blog-download
MAILCHIMP_DOWNLOAD_SLUG_MERGE_TAG=DL_SLUG
MAILCHIMP_DOWNLOAD_TITLE_MERGE_TAG=DL_TITLE
MAILCHIMP_DOWNLOAD_TYPE_MERGE_TAG=DL_TYPE
MAILCHIMP_DOWNLOAD_MERGE_FIELDS=true

# Static origin for all /media images (Cloudflare Pages preview / assets host)
NEXT_PUBLIC_MEDIA_BASE_URL=https://bogues-group.pages.dev

# Site URL for Open Graph page links (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
